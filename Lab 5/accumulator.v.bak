module accumulator (
    input  wire       clk,
    input  wire       reset_n,
    input  wire       load,
    input  wire [7:0] A,
    output reg  [7:0] S,
    output reg        Overflow
);

    reg [7:0] A_reg;

    wire [8:0] add_result;

    // 9-bit result gives us both:
    // add_result[7:0] = sum
    // add_result[8]   = carry
    assign add_result = A_reg + S;

    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            A_reg    <= 8'b00000000;
            S        <= 8'b00000000;
            Overflow <= 1'b0;
        end
        else if (load) begin
            // Capture switch input
            A_reg <= A;

            // Accumulate
            S <= add_result[7:0];

            // Save carry-out
            Overflow <= add_result[8];
        end
    end

endmodule