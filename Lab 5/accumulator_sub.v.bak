module accumulator_sub (
    input  wire       clk,
    input  wire       reset_n,
    input  wire       load,
    input  wire [7:0] A,
    input  wire       add_sub,
    output reg  [7:0] S,
    output reg        Overflow
);

    reg [7:0] A_reg;

    wire [7:0] A_modified;
    wire [8:0] add_result;

    // When add_sub = 0:
    // A_modified = A
    //
    // When add_sub = 1:
    // A_modified = ~A
    assign A_modified = A_reg ^ {8{add_sub}};

    // ADD:
    //     S + A + 0
    //
    // SUBTRACT:
    //     S + ~A + 1
    //
    // This gives S - A when add_sub = 1.
    assign add_result = S + A_modified + add_sub;

    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            A_reg    <= 8'b00000000;
            S        <= 8'b00000000;
            Overflow <= 1'b0;
        end
        else if (load) begin
            // Capture switch input
            A_reg <= A;

            // Add or subtract
            S <= add_result[7:0];

            // Save carry-out
            Overflow <= add_result[8];
        end
    end

endmodule